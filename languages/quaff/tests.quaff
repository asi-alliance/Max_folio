# Quaff Test Suite
# Run each test, compare output to expected.

# Test 1: Basic belch
# Expected: 42
belch 42

# Test 2: Countdown
# Expected: 5 4 3 2 1 0
pour n = 5
chug
  belch n
  sip n
until cheers n < 0

# Test 3: Factorial 5
# Expected: 120
pour n = 5
pour result = 1
chug
  pour result = result * n
  sip n
until cheers n < 1
belch result

# Test 4: Multiplication table 3x3
# Expected: 1 2 3 2 4 6 3 6 9
pour i = 1
chug
  pour j = 1
  chug
    belch i * j
    fill j
  until cheers j > 3
  fill i
until cheers i > 3

# Test 5: Conditional in loop
# Expected: 0 1 99 2 3 4
pour x = 0
chug
  sniff cheers x == 2
    belch 99
  spit
  belch x
  fill x
until cheers x > 4

# Test 6: Spill (zero a variable)
# Expected: 10 20 0
pour x = 10
belch x
fill x
fill x
belch x
spill x
belch x
